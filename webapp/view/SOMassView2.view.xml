    <Page  navButtonTooltip="Back" showNavButton="true" navButtonPress="onNavButtonPress">
        <customHeader>
            <Bar>
                <contentLeft>
                    <Button text="Back" 
                        icon="sap-icon://navigation-left-arrow" 
                        type="Reject" 
                        press="onNavButtonPress">
                    </Button>
                </contentLeft>  
                <contentMiddle>
                   
                </contentMiddle>             
                <contentRight>
                    <Button id="idActualRunButt" 
                        text="Actual Run" 
                        icon="sap-icon://accept" 
                        type="Success" 
                        visible="false" 
                        press="onPressActualRun">
                    </Button>
                </contentRight>
            </Bar>			
		</customHeader>   
        <subHeader>    
             <Bar>                
                <contentMiddle>
                    <Button id="idCreateMassSO" 
                        text="Mass Create Sales orders" 
                        type="Accept" 
                        icon="sap-icon://checklist" 
                        visible="false" 
                        press="onPressMassSOCreate">
                    </Button>
                </contentMiddle> 
                <contentRight>
                 <Button id="idTestRunButt" 
                    text="Test Run" 
                    type="Accept" 
                    icon="sap-icon://checklist" 
                    visible="false" 
                    press="onPressTestRun">
                 </Button>
                </contentRight> 
             </Bar>
        </subHeader>
