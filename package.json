{
  "name": "zsdmassmaint",
  "version": "0.0.1",
  "private": true,
  "description": "Mass Maintenance of sales order creation and change",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "main": "webapp/index.html",
  "devDependencies": {
    "@sap/ux-ui5-tooling": "^1.27.0",
    "@ui5/cli": "^4.0.24",
    "rimraf": "3.0.2",
    "ui5-task-flatten-library": "0.2.5",
    "@sap-ux/eslint-plugin-fiori-tools": "^10.0.0",
    "eslint": "^10"
  },
  "scripts": {
    "start": "fiori run --open 'test/flpSandbox.html?sap-client=100#comsdmassmaintparkerzsdmassmaint-display'",
    "start-local": "fiori run --config ./ui5-local.yaml --open 'test/flpSandbox.html?sap-client=100#comsdmassmaintparkerzsdmassmaint-display'",
    "build": "ui5 build --config=ui5.yaml --clean-dest --dest dist",
    "deploy": "npm run build && fiori deploy --config ui5-deploy.yaml",
    "deploy-config": "fiori add deploy-config",
    "start-noflp": "fiori run --open 'index.html?sap-client=100'",
    "start-mock": "fiori run --open 'test/flpSandboxMockServer.html?sap-client=100#comsdmassmaintparkerzsdmassmaint-display'",
    "start-variants-management": "fiori run --open \"preview.html?fiori-tools-rta-mode=true&sap-ui-rta-skip-flex-validation=true&sap-client=100#preview-app\"",
    "unit-tests": "fiori run --open test/unit/unitTests.qunit.html",
    "int-tests": "fiori run --open test/integration/opaTests.qunit.html",
    "undeploy": "npm run build && fiori undeploy --config ui5-deploy.yaml",
    "deploy-test": "npm run build && fiori deploy --config ui5-deploy.yaml --testMode true",
    "lint": "eslint ./"
  },
  "ui5": {
    "dependencies": [
      "@sap/ux-ui5-tooling",
      "ui5-task-flatten-library"
    ]
  },
  "sapuxLayer": "CUSTOMER_BASE"
}
